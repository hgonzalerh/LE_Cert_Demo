---
exclude_paths:
  - collections/ansible_collections/   # installed third-party collections
  - .navigator/
  - .ansible/

skip_list:
  # Role variables keep their original, unprefixed names on purpose: they are
  # passed as extra vars by existing jobs, and facts like cert_files,
  # cert_challenge and tls_compliant are the contract between roles.
  - var-naming[no-role-prefix]
